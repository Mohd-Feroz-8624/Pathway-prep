generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                @id @default(cuid())
  clerkId           String                @unique
  name              String?
  email             String                @unique
  college           String?
  branch            String?
  currentSemester   Int?
  careerGoal        String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  role              UserRole              @default(STUDENT)
  dsaProgress       DSAProgress[]
  interviewSessions InterviewSession[]
  profile           Profile?
  resumes           Resume[]
  roadmapProgress   RoadmapTaskProgress[]
  uploadedResumes   UploadedResume[]
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?
  avatarUrl String?
  phone     String?
  github    String?
  linkedin  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Semester {
  id        String    @id @default(cuid())
  number    Int       @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  subjects  Subject[]
}

model Subject {
  id         String   @id @default(cuid())
  name       String
  code       String?
  semesterId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  slug       String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  units      Unit[]

  @@unique([semesterId, slug])
  @@index([semesterId])
}

model Unit {
  id          String         @id @default(cuid())
  number      Int
  title       String
  subjectId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  description String?
  difficulty  String?
  duration    String?
  topics      Topic[]
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  resources   UnitResource[]

  @@unique([subjectId, number])
  @@index([subjectId])
}

model UnitResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String
  url         String?
  unitId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

model Topic {
  id        String   @id @default(cuid())
  title     String
  unitId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, title])
  @@index([unitId])
}

model Note {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String?
  topicId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  category    String?
  level       String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Roadmap {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  category    String?
  duration    String?
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  stages      RoadmapStage[]
}

model RoadmapStage {
  id          String        @id @default(cuid())
  title       String
  description String?
  order       Int
  roadmapId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  roadmap     Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks       RoadmapTask[]

  @@unique([roadmapId, order])
  @@index([roadmapId])
}

model RoadmapTask {
  id          String                @id @default(cuid())
  title       String
  description String?
  order       Int
  isRequired  Boolean               @default(true)
  resourceUrl String?
  stageId     String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  stage       RoadmapStage          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  progress    RoadmapTaskProgress[]

  @@unique([stageId, order])
  @@index([stageId])
}

model RoadmapTaskProgress {
  id          String      @id @default(cuid())
  userId      String
  taskId      String
  completed   Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  task        RoadmapTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
}

model ResumeTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  previewUrl  String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resumes     Resume[]
}

model Resume {
  id             String                @id @default(cuid())
  userId         String
  templateId     String?
  title          String                @default("My Resume")
  summary        String?
  phone          String?
  location       String?
  linkedin       String?
  github         String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  template       ResumeTemplate?       @relation(fields: [templateId], references: [id])
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements   ResumeAchievement[]
  certifications ResumeCertification[]
  education      ResumeEducation[]
  experience     ResumeExperience[]
  projects       ResumeProject[]
  skills         ResumeSkill[]

  @@index([userId])
  @@index([templateId])
}

model ResumeEducation {
  id          String   @id @default(cuid())
  resumeId    String
  institution String
  degree      String?
  field       String?
  startDate   String?
  endDate     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeExperience {
  id          String   @id @default(cuid())
  resumeId    String
  company     String
  position    String
  location    String?
  startDate   String?
  endDate     String?
  isCurrent   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeProject {
  id           String   @id @default(cuid())
  resumeId     String
  title        String
  description  String?
  technologies String?
  githubUrl    String?
  liveUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeSkill {
  id        String   @id @default(cuid())
  resumeId  String
  name      String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeCertification {
  id            String   @id @default(cuid())
  resumeId      String
  name          String
  issuer        String?
  issueDate     String?
  credentialUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  resume        Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeAchievement {
  id          String   @id @default(cuid())
  resumeId    String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeAnalysis {
  id                String   @id @default(cuid())
  uploadedResumeId  String
  targetRole        String
  overallScore      Int
  completenessScore Int
  keywordScore      Int
  experienceScore   Int
  atsStructureScore Int
  impactScore       Int
  readabilityScore  Int
  strengths         String?
  weaknesses        String?
  missingKeywords   String?
  recommendations   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  uploadedResume UploadedResume @relation(fields: [uploadedResumeId], references: [id], onDelete: Cascade)

  @@index([uploadedResumeId])
}

model UploadedResume {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  fileType  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses ResumeAnalysis[]

  @@index([userId])
}

model InterviewQuestion {
  id              String            @id @default(cuid())
  question        String
  role            String
  difficulty      String
  type            String
  evaluationGuide String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  answers         InterviewAnswer[]

  @@index([role, difficulty, type])
}

model InterviewSession {
  id          String            @id @default(cuid())
  userId      String
  role        String
  difficulty  String
  type        String
  status      String            @default("IN_PROGRESS")
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  answers     InterviewAnswer[]
  result      InterviewResult?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InterviewAnswer {
  id         String            @id @default(cuid())
  sessionId  String
  questionId String
  answer     String
  score      Int?
  feedback   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session    InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
}

model InterviewResult {
  id              String           @id @default(cuid())
  sessionId       String           @unique
  overallScore    Int
  strengths       String?
  weaknesses      String?
  recommendations String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  session         InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DSAQuestion {
  id                 String        @id @default(cuid())
  title              String
  slug               String        @unique
  description        String
  difficulty         String
  topic              String
  constraints        String?
  examples           String?
  solution           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  approach           String?
  concept            String?
  cppSolution        String?
  javaSolution       String?
  javascriptSolution String?
  pythonSolution     String?
  spaceComplexity    String?
  timeComplexity     String?
  progress           DSAProgress[]

  @@index([topic])
  @@index([difficulty])
  @@index([topic, difficulty])
}

model DSAProgress {
  id         String      @id @default(cuid())
  userId     String
  questionId String
  solved     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  question   DSAQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum UserRole {
  STUDENT
  ADMIN
}
